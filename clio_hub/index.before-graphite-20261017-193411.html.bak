<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>C.L.I.O.</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&family=Outfit:wght@600;700;800&display=swap" rel="stylesheet">
    <link rel="manifest" href="manifest.json">
    <link rel="icon" type="image/png" href="./clio_logo_official.png">
    <script src="https://unpkg.com/lucide@latest"></script>
    <!-- THREE.js prima di 3d-force-graph per nodeThreeObject -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <script src="https://unpkg.com/3d-force-graph"></script>
    <style>
        *, *::before, *::after { margin:0; padding:0; box-sizing:border-box; }
        :root {
            --cyan:    #00f3ff;
            --purple:  #a855f7;
            --magenta: #ec4899;
            --bg:      #030308;
            --font-h:  'Outfit', sans-serif;
            --font-b:  'Plus Jakarta Sans', sans-serif;
        }
        body {
            background: var(--bg);
            color: #fff;
            font-family: var(--font-b);
            overflow: hidden;
            height: 100vh;
        }

        /* ── MESH BACKGROUND ── */
        .mesh-container {
            position: fixed; inset: 0; z-index: 0;
            overflow: hidden; filter: blur(130px);
            pointer-events: none;
        }
        .mesh-orb { position: absolute; border-radius: 50%; }
        .mesh-1 { width:60vw; height:60vw; background:radial-gradient(circle,var(--purple),transparent 70%); top:-10%; left:-10%; opacity:0.12; animation:flowMesh 18s infinite ease-in-out; }
        .mesh-2 { width:55vw; height:55vw; background:radial-gradient(circle,var(--cyan),transparent 70%); bottom:-5%; right:-5%; opacity:0.09; animation:flowMesh 22s infinite ease-in-out reverse; }
        .mesh-3 { width:45vw; height:45vw; background:radial-gradient(circle,var(--magenta),transparent 70%); top:20%; right:15%; opacity:0.07; animation:flowMesh 30s infinite ease-in-out; }
        @keyframes flowMesh { 0%,100%{transform:translate(0,0)scale(1)} 50%{transform:translate(40px,30px)scale(1.1)} }
        .noise-surface { position:fixed; inset:0; z-index:0; opacity:0.025; background-image:url('https://grainy-gradients.vercel.app/noise.svg'); pointer-events:none; }

        /* ── BRAIN ── */
        #brain-main {
            position: fixed; inset: 0;
            width: 100vw; height: 100vh;
            z-index: 1;
            transition: opacity 0.8s ease;
        }

        /* Glow audio-reattivo */
        #brain-glow {
            position: fixed; inset: 0; z-index: 2;
            pointer-events: none; opacity: 0;
            transition: opacity 0.1s linear;
            background: radial-gradient(ellipse at center,
                rgba(0,191,255,0.22) 0%,
                rgba(168,85,247,0.08) 40%,
                transparent 70%);
        }

        /* Ring audio che pulsa attorno al brain */
        #audio-ring {
            position: fixed;
            top: 50%; left: 50%;
            width: 300px; height: 300px;
            margin-left: -150px; margin-top: -150px;
            border-radius: 50%;
            border: 2px solid rgba(0,191,255,0);
            box-shadow: none;
            z-index: 3; pointer-events: none;
        }

        /* Stato audio browser — pill in basso a sinistra sopra recall */
        #audio-status {
            position: fixed; bottom: 148px; left: 26px; z-index: 60;
            display: flex; align-items: center; gap: 7px;
            background: rgba(5,5,18,0.82);
            border: 1px solid rgba(255,255,255,0.08);
            border-radius: 20px; padding: 5px 12px;
            font-size: 0.6rem; letter-spacing: 1.5px; text-transform: uppercase;
            color: rgba(255,255,255,0.3);
            backdrop-filter: blur(12px);
            cursor: pointer;
            transition: all 0.3s ease;
        }
        #audio-status.audio-on  { color:var(--cyan); border-color:rgba(0,243,255,0.35); box-shadow:0 0 8px rgba(0,243,255,0.15); }
        #audio-status.clio-on   { color:#4ade80;     border-color:rgba(74,222,128,0.35); box-shadow:0 0 8px rgba(74,222,128,0.15); }
        #audio-status.mic-error { color:#f87171;     border-color:rgba(248,113,113,0.45); }
        #audio-status-dot { width:5px; height:5px; border-radius:50%; background:currentColor; }
        #audio-status.audio-on  #audio-status-dot { animation:blink 1.2s infinite; }
        #audio-status.clio-on   #audio-status-dot { animation:blink 0.6s infinite; }

        /* Hint permesso mic */
        #mic-hint {
            position: fixed; bottom: 100px; left: 50%;
            transform: translateX(-50%);
            z-index: 60;
            background: rgba(5,5,18,0.9);
            border: 1px solid rgba(0,191,255,0.35);
            border-radius: 14px; padding: 12px 20px;
            font-size: 0.75rem; letter-spacing: 1px;
            color: rgba(0,191,255,0.8);
            backdrop-filter: blur(16px);
            display: flex; align-items: center; gap: 10px;
            cursor: pointer;
            animation: hintFade 0.5s ease;
            box-shadow: 0 0 20px rgba(0,191,255,0.12);
        }
        #mic-hint.hidden { display: none; }
        #mic-hint-dot { width:6px; height:6px; border-radius:50%; background:#00BFFF; box-shadow:0 0 8px #00BFFF; animation:blink 1.5s infinite; }
        @keyframes hintFade { from{opacity:0;transform:translateX(-50%)translateY(10px)} to{opacity:1;transform:translateX(-50%)translateY(0)} }

        /* ── CORNER LOGO ── */
        .corner-logo {
            position: fixed; top: 20px; left: 24px; z-index: 50;
            display: flex; align-items: center; gap: 12px;
            cursor: pointer;
        }
        .corner-logo img {
            width: 42px; height: 42px; border-radius: 50%;
            filter: drop-shadow(0 0 10px rgba(168,85,247,0.8));
            transition: filter 0.3s ease, transform 0.3s ease;
        }
        body.brain-listening .corner-logo img {
            filter: drop-shadow(0 0 16px rgba(0,191,255,1));
            animation: logoPulse 1.5s ease-in-out infinite;
        }
        @keyframes logoPulse { 0%,100%{transform:scale(1)} 50%{transform:scale(1.06)} }
        .logo-text { font-family:var(--font-h); font-size:1.05rem; font-weight:800; letter-spacing:4px; background:linear-gradient(to right,#fff,rgba(255,255,255,0.45)); -webkit-background-clip:text; background-clip:text; -webkit-text-fill-color:transparent; }
        .logo-acronym { margin-top:5px; display:flex; flex-direction:column; gap:2px; }
        .logo-acronym-row { font-size:0.5rem; letter-spacing:1.5px; line-height:1.3; color:rgba(255,255,255,0.35); text-transform:uppercase; }
        .logo-acronym-row b { color:var(--cyan); font-weight:800; letter-spacing:2px; }

        /* ── STATUS BADGES ── */
        .status-strip {
            position: fixed; top: 18px; left: 50%;
            transform: translateX(-50%);
            z-index: 50; display: flex; gap: 6px; flex-wrap: wrap; justify-content: center;
            max-width: 94vw;
        }
        .badge {
            display: flex; align-items: center; gap: 6px;
            padding: 6px 11px;
            background: rgba(255,255,255,0.04);
            border: 1px solid rgba(255,255,255,0.1);
            border-radius: 20px; font-size: 0.68rem;
            font-weight: 600; letter-spacing: 0.6px;
            color: rgba(255,255,255,0.72);
            transition: all 0.3s ease;
            backdrop-filter: blur(14px);
            white-space: nowrap;
        }
        .badge i { width: 13px; height: 13px; flex-shrink: 0; }
        /* Stato semaforico coerente: verde=ok, giallo=attenzione, rosso=critico */
        .badge-ok   { color:#4ade80!important; border-color:rgba(74,222,128,0.4)!important;  box-shadow:0 0 8px rgba(74,222,128,0.15); }
        .badge-warn { color:#ffb800!important; border-color:rgba(255,184,0,0.45)!important;  box-shadow:0 0 8px rgba(255,184,0,0.15); }
        .badge-crit { color:#f87171!important; border-color:rgba(248,113,113,0.5)!important; box-shadow:0 0 8px rgba(248,113,113,0.2); animation:badgeCritPulse 1.6s ease-in-out infinite; }
        .badge-idle { opacity: 0.42; }
        @keyframes badgeCritPulse { 0%,100%{opacity:1} 50%{opacity:.6} }
        /* Mantenuti per compatibilità */
        .badge-active      { color:var(--cyan)!important; border-color:rgba(0,243,255,0.32)!important; box-shadow:0 0 7px rgba(0,243,255,0.12); }
        .badge-disconnected,
        .badge-inactive    { opacity: 0.42; }
        .badge-healing     { color:#ffb800!important; border-color:rgba(255,184,0,0.4)!important; }
        #status-brain      { cursor:pointer; }

        /* ── BRAIN LIVE LABEL ── */
        .brain-corner {
            position: fixed; top: 22px; right: 22px; z-index: 50;
            display: flex; align-items: center; gap: 7px;
            font-family: var(--font-h); font-size: 0.62rem; letter-spacing: 2px;
            color: rgba(0,191,255,0.5); pointer-events: none;
        }
        .brain-corner-dot {
            width: 5px; height: 5px; border-radius: 50%;
            background: #00BFFF; box-shadow: 0 0 6px #00BFFF;
            animation: blink 2.5s ease-in-out infinite;
        }
        @keyframes blink { 0%,100%{opacity:1} 50%{opacity:.15} }

        /* ── INTERACTION DOCK ── */
        .interaction-dock {
            position: fixed; inset: 0;
            padding: 0 20px 22px;
            display: flex; flex-direction: column; align-items: center; justify-content: flex-end;
            z-index: 40; pointer-events: none;
        }
        .interaction-dock > * { pointer-events: auto; width: 100%; max-width: 760px; }
        /* Blocco conversazione: centrato verticalmente nello spazio sopra l'input,
           così il primo messaggio appare vicino al centro (non incollato in basso). */
        .dock-main {
            flex: 1 1 auto; min-height: 0;
            display: flex; flex-direction: column; justify-content: center; align-items: center;
            width: 100%; max-width: 760px; pointer-events: none;
        }
        .dock-main > * { pointer-events: auto; width: 100%; }

        .speech-overlay {
            background: rgba(4,4,14,0.88);
            backdrop-filter: blur(26px);
            border: 1px solid rgba(255,255,255,0.06);
            border-radius: 20px; padding: 18px 22px;
            display: flex; flex-direction: column; gap: 10px;
            opacity: 0; visibility: hidden;
            transform: translateY(8px) scale(0.98);
            transition: all 0.4s cubic-bezier(0.19,1,0.22,1);
            margin-bottom: 10px;
            box-shadow: 0 30px 80px rgba(0,0,0,0.7);
        }
        .speech-overlay.active { opacity:1!important; visibility:visible!important; transform:translateY(0)scale(1); }
        /* Da chiuso non deve occupare spazio (niente vuoto fantasma nel dock) */
        .speech-overlay:not(.active) { max-height:0; padding-top:0; padding-bottom:0; margin-bottom:0; border-width:0; overflow:hidden; }
        .speech-header { display:flex; justify-content:space-between; align-items:center; border-bottom:1px solid rgba(255,255,255,0.04); padding-bottom:9px; }
        .clio-indicator { color:var(--magenta); font-size:8px; font-weight:900; letter-spacing:2.5px; text-transform:uppercase; display:flex; align-items:center; gap:7px; }
        .clio-indicator::before { content:''; width:5px; height:5px; background:var(--magenta); border-radius:50%; box-shadow:0 0 8px var(--magenta); animation:blink 2s infinite; }
        .skip-btn { background:rgba(255,255,255,0.04); border:1px solid rgba(255,255,255,0.07); color:rgba(255,255,255,0.45); padding:5px 12px; border-radius:9px; font-size:10px; font-weight:700; display:flex; align-items:center; gap:7px; cursor:pointer; transition:all 0.3s ease; }
        .skip-btn:hover { background:rgba(236,72,153,0.1); border-color:var(--magenta); color:#fff; }
        .speech-content { font-size:14px; line-height:1.7; color:rgba(255,255,255,0.9); max-height:38vh; overflow-y:auto; min-width:0; overflow-wrap:anywhere; word-break:break-word; padding:2px 8px 2px 0; scrollbar-width:thin; scrollbar-color:rgba(255,255,255,0.18) transparent; }
        .speech-content::-webkit-scrollbar { width:6px; }
        .speech-content::-webkit-scrollbar-thumb { background:rgba(255,255,255,0.18); border-radius:3px; }

        .chat-history { width:100%; max-height:min(42vh, 420px); overflow-y:auto; display:flex; flex-direction:column; gap:7px; padding:0 2px; margin-bottom:8px; scrollbar-width:thin; scrollbar-color:rgba(255,255,255,0.1) transparent; }
        .chat-msg { display:flex; }
        .chat-msg-user { justify-content:flex-end; }
        .chat-msg-clio { justify-content:flex-start; }
        .chat-bubble { background:rgba(10,12,24,0.72); border:1px solid rgba(255,255,255,0.09); border-radius:14px; padding:10px 16px; max-width:75%; backdrop-filter:blur(12px); overflow-wrap:anywhere; word-break:break-word; }
        .chat-msg-user .chat-bubble { background:rgba(236,72,153,0.1); border-color:rgba(236,72,153,0.22); }
        .chat-msg-clio .chat-bubble { background:rgba(0,243,255,0.05); border-color:rgba(0,243,255,0.16); }
        .chat-role { font-size:8px; font-weight:800; letter-spacing:2px; opacity:0.4; display:block; margin-bottom:4px; }
        .chat-msg-user .chat-role { color:var(--magenta); }
        .chat-msg-clio .chat-role { color:var(--cyan); }
        .chat-bubble p { font-size:13px; line-height:1.55; color:rgba(255,255,255,0.92); overflow-wrap:anywhere; word-break:break-word; }

        .command-center { width:100%; }
        .input-container {
            background: rgba(8,8,20,0.88);
            backdrop-filter: blur(30px);
            border: 1px solid rgba(255,255,255,0.1);
            border-radius: 30px; padding: 7px 9px 7px 22px;
            display: flex; align-items: center; gap: 9px;
            transition: all 0.4s ease;
            box-shadow: 0 8px 40px rgba(0,0,0,0.65);
        }
        .input-container:focus-within { border-color:var(--cyan); box-shadow:0 0 28px rgba(0,243,255,0.1),0 10px 50px rgba(0,0,0,0.7); transform:translateY(-2px); }
        #clio-command { background:none; border:none; color:#fff; flex-grow:1; height:44px; font-size:15px; font-family:var(--font-b); outline:none; }
        #clio-command::placeholder { color:rgba(255,255,255,0.25); }
        .input-actions { display:flex; align-items:center; gap:16px; }
        .action-btn, .send-btn { background:rgba(255,255,255,0.05); border:1px solid rgba(255,255,255,0.07); color:rgba(255,255,255,0.45); width:44px; height:44px; border-radius:22px; display:flex; align-items:center; justify-content:center; cursor:pointer; transition:all 0.3s ease; }
        .action-btn:hover { background:rgba(0,243,255,0.08); color:var(--cyan); transform:scale(1.05); }
        /* Mic ben distinto dall'invio: alone ciano + separatore verticale prima dell'invio */
        #mic-btn { position:relative; border-color:rgba(0,243,255,0.25); color:rgba(0,243,255,0.8); }
        #mic-btn:hover { background:rgba(0,243,255,0.12); color:var(--cyan); }
        .input-actions #mic-btn::after { content:''; position:absolute; right:-9px; top:50%; transform:translateY(-50%); width:1px; height:24px; background:rgba(255,255,255,0.12); }
        .send-btn { background:var(--magenta); color:#fff; border:none; box-shadow:0 4px 14px rgba(236,72,153,0.3); }
        .send-btn:hover { transform:scale(1.08); box-shadow:0 6px 20px rgba(236,72,153,0.5); }
        .send-btn i, .action-btn i { width:19px; height:19px; }
        /* mic attivo */
        .action-btn.mic-active { background:rgba(0,243,255,0.2)!important; color:var(--cyan)!important; border-color:var(--cyan)!important; box-shadow:0 0 18px rgba(0,243,255,0.5); animation:micPulse 1s ease-in-out infinite; }
        @keyframes micPulse { 0%,100%{box-shadow:0 0 12px rgba(0,243,255,0.4);} 50%{box-shadow:0 0 28px rgba(0,243,255,0.8), 0 0 50px rgba(0,243,255,0.3);} }

        .action-history-ghost { position:fixed; right:26px; top:50%; transform:translateY(-50%); display:flex; flex-direction:column; gap:10px; z-index:50; pointer-events:none; }
        .history-item { background:rgba(255,255,255,0.04); border:1px solid rgba(255,255,255,0.07); padding:7px 14px; border-radius:10px; backdrop-filter:blur(8px); font-size:10px; color:rgba(255,255,255,0.42); display:flex; align-items:center; gap:7px; animation:slideInRight 0.4s ease forwards,fadeOut 3s ease forwards 5s; }
        .history-item i { color:var(--cyan); width:11px; height:11px; }
        @keyframes slideInRight { from{opacity:0;transform:translateX(40px)} to{opacity:1;transform:translateX(0)} }
        @keyframes fadeOut { to{opacity:0;transform:translateY(-8px)} }

        .recall-btn { position:fixed; bottom:88px; left:26px; width:42px; height:42px; border-radius:50%; background:rgba(168,85,247,0.15); border:1px solid rgba(168,85,247,0.3); color:var(--purple); display:flex; align-items:center; justify-content:center; cursor:pointer; transition:all 0.3s ease; z-index:50; }
        .recall-btn:hover { background:rgba(168,85,247,0.3); transform:scale(1.1); box-shadow:0 0 14px rgba(168,85,247,0.3); }
        .recall-btn i { width:17px; height:17px; }

        #brain-info-card { position:fixed; bottom:106px; right:22px; width:245px; z-index:50; background:rgba(4,6,18,0.92); border:1px solid rgba(0,191,255,0.3); border-radius:12px; padding:13px 15px; backdrop-filter:blur(16px); opacity:0; transform:translateY(10px); transition:opacity .4s,transform .4s; pointer-events:none; box-shadow:0 0 18px rgba(0,191,255,0.1); }
        #brain-info-card.visible { opacity:1; transform:translateY(0); }
        #brain-info-card h3 { color:#00BFFF; margin:0 0 5px; font-size:.82rem; font-family:var(--font-h); }
        #brain-info-card p  { color:rgba(255,255,255,0.62); font-size:.71rem; line-height:1.5; margin:0; }

        /* ── LIVE CLOCK ── */
        #clock-widget { position:fixed; top:14px; right:22px; z-index:50; text-align:right; pointer-events:none; }
        #clock-time { font-family:var(--font-h); font-size:1.35rem; font-weight:800; background:linear-gradient(to right,var(--cyan),rgba(255,255,255,0.7)); -webkit-background-clip:text; background-clip:text; -webkit-text-fill-color:transparent; letter-spacing:3px; }
        #clock-date { font-size:0.52rem; color:rgba(255,255,255,0.28); letter-spacing:1.5px; text-transform:uppercase; margin-top:1px; }

        /* ── TOAST NOTIFICATIONS ── */
        #toast-container { position:fixed; top:72px; right:22px; z-index:200; display:flex; flex-direction:column; gap:8px; pointer-events:none; width:280px; }
        .toast { background:rgba(4,8,20,0.96); border:1px solid rgba(0,243,255,0.3); border-radius:12px; padding:11px 15px; backdrop-filter:blur(24px); opacity:0; transform:translateX(20px); transition:all 0.45s cubic-bezier(0.19,1,0.22,1); box-shadow:0 0 24px rgba(0,243,255,0.08); pointer-events:auto; }
        .toast.visible { opacity:1; transform:translateX(0); }
        .toast-label { font-size:8px; letter-spacing:2px; color:var(--cyan); font-weight:800; margin-bottom:4px; text-transform:uppercase; }
        .toast p { font-size:11.5px; line-height:1.5; color:rgba(255,255,255,0.85); margin:0; }
        .toast-security { border-color:rgba(255,80,80,0.5); box-shadow:0 0 20px rgba(255,80,80,0.1); }
        .toast-security .toast-label { color:#ff5050; }

        /* ── QUICK ACTIONS ── */
        .quick-actions { display:flex; gap:6px; overflow-x:auto; scrollbar-width:none; padding:2px 0 4px; }
        .quick-actions::-webkit-scrollbar { display:none; }
        .quick-pill { background:rgba(255,255,255,0.04); border:1px solid rgba(255,255,255,0.07); border-radius:18px; padding:5px 13px; white-space:nowrap; font-size:11px; color:rgba(255,255,255,0.5); cursor:pointer; transition:all 0.22s ease; backdrop-filter:blur(10px); display:flex; align-items:center; gap:5px; flex-shrink:0; user-select:none; }
        .quick-pill:hover { background:rgba(0,243,255,0.09); border-color:rgba(0,243,255,0.3); color:var(--cyan); transform:translateY(-2px); box-shadow:0 4px 12px rgba(0,243,255,0.1); }
        .quick-pill:active { transform:translateY(0); }

        /* ── VISION PANEL ── */
        #vision-panel { position:fixed; bottom:370px; right:22px; width:220px; z-index:50; background:rgba(3,5,16,0.94); border:1px solid rgba(0,191,255,0.22); border-radius:14px; overflow:hidden; backdrop-filter:blur(20px); box-shadow:0 0 22px rgba(0,191,255,0.08); display:none; animation:fadeInUp 0.4s ease; }
        #vision-panel.open { display:block; }
        @keyframes fadeInUp { from{opacity:0;transform:translateY(12px)} to{opacity:1;transform:translateY(0)} }
        #vision-panel img { width:100%; display:block; opacity:0.88; border-bottom:1px solid rgba(0,191,255,0.12); }
        #vision-panel-header { padding:8px 11px; display:flex; align-items:center; justify-content:space-between; }
        #vision-panel-label { font-size:8px; letter-spacing:2px; color:rgba(0,191,255,0.65); text-transform:uppercase; font-weight:800; }
        #vision-age { font-size:8px; color:rgba(255,255,255,0.25); }
        #vision-desc { padding:0 11px 10px; font-size:10px; line-height:1.5; color:rgba(255,255,255,0.48); max-height:70px; overflow:hidden; }
        #vision-btn { position:fixed; bottom:370px; right:255px; z-index:51; width:34px; height:34px; background:rgba(0,191,255,0.08); border:1px solid rgba(0,191,255,0.22); border-radius:50%; display:flex; align-items:center; justify-content:center; cursor:pointer; transition:all 0.3s; color:rgba(0,191,255,0.55); }
        #vision-btn:hover { background:rgba(0,191,255,0.2); color:var(--cyan); box-shadow:0 0 12px rgba(0,191,255,0.2); }
        #vision-btn i { width:14px; height:14px; }
        #vision-btn.active { background:rgba(0,191,255,0.2); color:var(--cyan); border-color:var(--cyan); }

        /* ── TYPEWRITER cursor ── */
        .typewriter-cursor { display:inline-block; width:2px; height:1em; background:var(--cyan); margin-left:2px; vertical-align:text-bottom; animation:blink 0.8s infinite; }

        /* ── CODING PANEL ── */
        #coding-panel { position:fixed; top:50%; left:50%; transform:translate(-50%,-50%); width:680px; max-width:90vw; z-index:100; background:rgba(3,5,16,0.96); border:1px solid rgba(0,191,255,0.22); border-radius:14px; overflow:hidden; backdrop-filter:blur(24px); box-shadow:0 0 40px rgba(0,191,255,0.15); display:none; flex-direction:column; animation:fadeInUp 0.3s ease; }
        #coding-panel.open { display:flex; }
        #coding-panel-header { padding:12px 16px; border-bottom:1px solid rgba(0,191,255,0.12); display:flex; justify-content:space-between; align-items:center; }
        #coding-panel-title { font-size:12px; letter-spacing:2px; color:rgba(0,191,255,0.8); text-transform:uppercase; font-weight:800; display:flex; align-items:center; gap:8px; }
        #coding-close { cursor:pointer; color:rgba(255,255,255,0.5); transition:color 0.2s; display:flex; align-items:center; }
        #coding-close:hover { color:var(--cyan); }
        #coding-panel-body { padding:16px; display:flex; flex-direction:column; gap:12px; max-height:80vh; overflow-y:auto; scrollbar-width:thin; scrollbar-color:rgba(0,191,255,0.2) transparent; }
        .coding-input-group { display:flex; flex-direction:column; gap:6px; }
        .coding-label { font-size:9px; letter-spacing:1px; color:rgba(255,255,255,0.5); text-transform:uppercase; font-weight:700; }
        #coding-workspace { background:rgba(0,0,0,0.3); border:1px solid rgba(255,255,255,0.1); border-radius:8px; padding:8px 12px; color:#fff; font-family:var(--font-b); font-size:12px; outline:none; transition:all 0.3s; }
        #coding-workspace:focus { border-color:var(--cyan); box-shadow:0 0 10px rgba(0,191,255,0.1); }
        #coding-prompt { background:rgba(0,0,0,0.3); border:1px solid rgba(255,255,255,0.1); border-radius:8px; padding:12px; color:#fff; font-family:var(--font-b); font-size:13px; min-height:80px; resize:vertical; outline:none; transition:all 0.3s; }
        #coding-prompt:focus { border-color:var(--cyan); box-shadow:0 0 10px rgba(0,191,255,0.1); }
        .coding-actions { display:flex; gap:10px; margin-top:4px; }
        .coding-btn { flex:1; padding:10px; border-radius:8px; border:none; font-weight:700; cursor:pointer; transition:all 0.2s; font-size:11px; letter-spacing:1px; text-transform:uppercase; display:flex; justify-content:center; align-items:center; gap:8px; }
        #coding-start { background:rgba(0,191,255,0.12); color:var(--cyan); border:1px solid rgba(0,191,255,0.3); }
        #coding-start:hover { background:rgba(0,191,255,0.22); box-shadow:0 0 15px rgba(0,191,255,0.2); }
        #coding-stop { background:rgba(236,72,153,0.12); color:var(--magenta); border:1px solid rgba(236,72,153,0.3); display:none; }
        #coding-stop:hover { background:rgba(236,72,153,0.22); box-shadow:0 0 15px rgba(236,72,153,0.2); }
        #coding-output { background:rgba(0,0,0,0.6); border:1px solid rgba(0,191,255,0.15); border-radius:8px; padding:12px; color:rgba(255,255,255,0.85); font-family:monospace; font-size:11.5px; line-height:1.5; white-space:pre-wrap; overflow-y:auto; max-height:350px; display:none; scrollbar-width:thin; scrollbar-color:rgba(0,191,255,0.3) transparent; }

        /* ── AUTOMATIONS PANEL ── */
        #automations-panel { position:fixed; top:50%; left:50%; transform:translate(-50%,-50%); width:580px; max-width:90vw; max-height:85vh; z-index:100; background:rgba(3,5,16,0.96); border:1px solid rgba(0,191,255,0.22); border-radius:14px; overflow:hidden; backdrop-filter:blur(24px); box-shadow:0 0 40px rgba(0,191,255,0.15); display:none; flex-direction:column; animation:fadeInUp 0.3s ease; }
        #automations-panel.open { display:flex; }
        #automations-panel-header { padding:12px 16px; border-bottom:1px solid rgba(0,191,255,0.12); display:flex; justify-content:space-between; align-items:center; }
        #automations-panel-title { font-size:12px; letter-spacing:2px; color:rgba(0,191,255,0.8); text-transform:uppercase; font-weight:800; display:flex; align-items:center; gap:8px; }
        #automations-close { cursor:pointer; color:rgba(255,255,255,0.5); transition:color 0.2s; display:flex; align-items:center; }
        #automations-close:hover { color:var(--cyan); }
        #automations-list { padding:8px 0; overflow-y:auto; flex:1; scrollbar-width:thin; scrollbar-color:rgba(0,191,255,0.2) transparent; }
        .automation-item { padding:10px 16px; border-bottom:1px solid rgba(255,255,255,0.05); display:flex; justify-content:space-between; align-items:center; transition:background 0.2s; }
        .automation-item:hover { background:rgba(255,255,255,0.03); }
        .automation-info { display:flex; flex-direction:column; gap:4px; }
        .automation-name { font-size:12px; font-weight:700; color:rgba(255,255,255,0.9); }
        .automation-badge { font-size:9px; padding:2px 6px; border-radius:4px; letter-spacing:1px; text-transform:uppercase; font-weight:700; width:fit-content; }
        .badge-ro { background:rgba(74,222,128,0.1); color:#4ade80; border:1px solid rgba(74,222,128,0.3); }
        .badge-rw { background:rgba(248,113,113,0.1); color:#f87171; border:1px solid rgba(248,113,113,0.3); }
        .automation-btn { background:rgba(0,191,255,0.1); border:1px solid rgba(0,191,255,0.3); color:var(--cyan); padding:6px 12px; border-radius:6px; font-size:10px; font-weight:700; cursor:pointer; transition:all 0.2s; text-transform:uppercase; }
        .automation-btn:hover { background:rgba(0,191,255,0.2); box-shadow:0 0 10px rgba(0,191,255,0.15); }

        /* ── MODEL MENU ── */
        .model-menu { position:fixed; top:52px; left:50%; transform:translateX(-50%) translateY(-10px); z-index:100; background:rgba(3,5,16,0.96); border:1px solid rgba(0,191,255,0.22); border-radius:12px; padding:8px 0; backdrop-filter:blur(24px); box-shadow:0 0 30px rgba(0,0,0,0.8), 0 0 20px rgba(0,191,255,0.1); opacity:0; pointer-events:none; transition:all 0.3s ease; display:flex; flex-direction:column; min-width:180px; }
        .model-menu.open { opacity:1; pointer-events:auto; transform:translateX(-50%) translateY(0); }
        .model-option { padding:8px 16px; font-size:11px; color:rgba(255,255,255,0.7); cursor:pointer; transition:all 0.2s; font-weight:600; letter-spacing:1px; white-space:nowrap; }
        .model-option:hover { background:rgba(0,191,255,0.1); color:var(--cyan); padding-left:20px; }

        /* ── RESPONSIVE / LAYOUT CENTRATO ── */
        /* Schermi grandi: colonna più ampia e centrata, niente effetto "tutto a sinistra" */
        @media (min-width: 1600px) {
            .interaction-dock > *, .dock-main { max-width: 920px; }
            .chat-bubble { max-width: 68%; }
            .speech-content { font-size: 15px; }
        }
        @media (max-width: 900px) {
            .chat-history { max-height: 32vh; }
        }
        @media (max-width: 768px) {
            .interaction-dock { padding: 0 12px 16px; }
            .badge { font-size: 0.58rem; padding: 4px 8px; }
            .corner-logo { display: none; }
        }

        /* ══════════════════════════════════════════════════════════
           RESTYLE "JARVIS" — orbe, sfondo animato, glass, dock
           (blocco aggiunto in coda: vince sulle regole precedenti)
           ══════════════════════════════════════════════════════════ */

        /* ── 2. SFONDO ANIMATO: gradiente radiale lento #0a0a1a → #1a0a2a ── */
        #bg-gradient {
            position: fixed; inset: -12%; z-index: -1; pointer-events: none;
            background:
                radial-gradient(circle at 28% 26%, #1a0a2a 0%, rgba(26,10,42,0) 52%),
                radial-gradient(circle at 72% 74%, #0d1730 0%, rgba(13,23,48,0) 52%),
                radial-gradient(circle at 50% 50%, #0a0a1a 0%, #05050d 68%, #030308 100%);
            background-size: 180% 180%, 180% 180%, 100% 100%;
            animation: bgDrift 42s ease-in-out infinite;
        }
        @keyframes bgDrift {
            0%,100% { background-position: 0% 0%, 100% 100%, 50% 50%; }
            33%     { background-position: 42% 22%, 58% 78%, 50% 50%; }
            66%     { background-position: 22% 62%, 78% 32%, 50% 50%; }
        }
        /* ── 2b. PARTICELLE LUMINOSE (canvas leggero, disegnato via rAF) ── */
        #particles {
            position: fixed; inset: 0; z-index: 1;
            width: 100%; height: 100%; pointer-events: none; opacity: 0.6;
        }

        /* ── 1. ORBE PROTAGONISTA (≥300px) ── */
        #orb {
            position: fixed; top: 50%; left: 50%;
            width: 360px; height: 360px;
            transform: translate(-50%, -50%);
            z-index: 1; pointer-events: none;
            will-change: transform;
        }
        .orb-core {
            position: absolute; inset: 0; border-radius: 50%;
            background:
                radial-gradient(circle at 38% 34%, rgba(0,243,255,0.95) 0%, rgba(0,191,255,0.55) 20%, rgba(168,85,247,0.5) 52%, rgba(88,28,135,0.16) 78%, transparent 100%),
                radial-gradient(circle at 66% 70%, rgba(236,72,153,0.4) 0%, transparent 56%);
            box-shadow:
                0 0 90px rgba(0,191,255,0.45),
                0 0 180px rgba(168,85,247,0.30),
                0 0 320px rgba(0,191,255,0.18),
                inset 0 0 80px rgba(0,243,255,0.35);
            filter: saturate(1.15);
        }
        .orb-ring {
            position: absolute; inset: -8%; border-radius: 50%;
            border: 1px solid rgba(0,243,255,0.35);
            box-shadow: 0 0 40px rgba(0,191,255,0.25), inset 0 0 40px rgba(168,85,247,0.2);
        }
        .orb-ring.ring-2 { inset: -18%; border-color: rgba(168,85,247,0.28); opacity: 0.55; }

        /* ── 5b. BEAM: filo luminoso che collega il dock all'orbe ── */
        .dock-beam {
            position: fixed; left: 50%; bottom: 96px; transform: translateX(-50%);
            width: 2px; height: 26vh; z-index: 1; pointer-events: none;
            background: linear-gradient(to top, rgba(0,243,255,0.45), rgba(168,85,247,0.22) 45%, transparent 100%);
            filter: blur(1.2px); opacity: 0.45;
            animation: beamPulse 4.5s ease-in-out infinite;
        }
        @keyframes beamPulse { 0%,100%{opacity:.32} 50%{opacity:.6} }

        /* ── 4. TOP BAR OLOGRAFICA + badge con alone ── */
        .status-strip {
            padding: 7px 10px; border-radius: 22px; border: 0;
            background: linear-gradient(180deg, rgba(10,10,26,0.72), rgba(6,6,16,0.5));
            box-shadow: 0 12px 42px rgba(0,0,0,0.55), 0 0 34px rgba(0,191,255,0.09);
            backdrop-filter: blur(16px) saturate(1.2);
            -webkit-backdrop-filter: blur(16px) saturate(1.2);
        }
        .status-strip::before {
            content: ''; position: absolute; inset: 0; border-radius: inherit; padding: 1px;
            background: linear-gradient(120deg, rgba(0,243,255,0.55), rgba(168,85,247,0.42), rgba(236,72,153,0.35), rgba(0,243,255,0.55));
            -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
            mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
            -webkit-mask-composite: xor; mask-composite: exclude;
            pointer-events: none;
        }
        .badge-ok     { box-shadow: 0 0 12px rgba(74,222,128,0.40),  inset 0 0 10px rgba(74,222,128,0.10); }
        .badge-warn   { box-shadow: 0 0 12px rgba(255,184,0,0.45),   inset 0 0 10px rgba(255,184,0,0.10); }
        .badge-crit   { box-shadow: 0 0 18px rgba(248,113,113,0.55), inset 0 0 12px rgba(248,113,113,0.16); }
        .badge-active { box-shadow: 0 0 12px rgba(0,243,255,0.28),   inset 0 0 9px rgba(0,243,255,0.08); }

        /* ── 3. CHAT GLASSMORFISM (sospesa sopra l'orbe) ── */
        .chat-history { max-height: 60vh; gap: 10px; margin-bottom: 12px; }
        .chat-bubble {
            background: rgba(255,255,255,0.05);
            border: 1px solid rgba(255,255,255,0.15);
            border-radius: 16px; padding: 12px 18px; max-width: 78%;
            backdrop-filter: blur(10px) saturate(1.25);
            -webkit-backdrop-filter: blur(10px) saturate(1.25);
            box-shadow: 0 10px 34px rgba(0,0,0,0.38), inset 0 1px 0 rgba(255,255,255,0.09);
        }
        .chat-msg-user .chat-bubble {
            background: rgba(236,72,153,0.12); border-color: rgba(236,72,153,0.42);
            box-shadow: 0 0 24px rgba(236,72,153,0.14), inset 0 1px 0 rgba(255,255,255,0.09);
        }
        .chat-msg-clio .chat-bubble {
            background: rgba(0,243,255,0.07); border-color: rgba(0,243,255,0.32);
            box-shadow: 0 0 24px rgba(0,243,255,0.14), inset 0 1px 0 rgba(255,255,255,0.09);
        }
        .chat-bubble p { font-size: 1rem; line-height: 1.6; }

        /* ── 5. DOCK INTEGRATO con bordo luminoso ── */
        .input-container {
            border: 1px solid rgba(0,243,255,0.38);
            box-shadow: 0 0 34px rgba(0,191,255,0.16), 0 16px 54px rgba(0,0,0,0.72),
                        inset 0 0 26px rgba(0,191,255,0.05);
        }
        .input-container:focus-within {
            border-color: var(--cyan);
            box-shadow: 0 0 46px rgba(0,243,255,0.28), 0 16px 54px rgba(0,0,0,0.75),
                        inset 0 0 30px rgba(0,243,255,0.08);
        }

        /* ── 7. RESPONSIVE (override finali: vincono su quelli esistenti) ── */
        @media (min-width: 1600px) {
            .interaction-dock > *, .dock-main { max-width: 1080px; }
            #orb { width: 420px; height: 420px; }
            .chat-history { max-height: 62vh; }
        }
        @media (max-width: 900px) {
            .chat-history { max-height: 42vh; }
            #orb { width: 270px; height: 270px; }
        }
        @media (max-height: 760px) {
            .chat-history { max-height: 40vh; }
        }
        @media (prefers-reduced-motion: reduce) {
            #bg-gradient, .dock-beam { animation: none; }
        }
    </style>
</head>
<body>

    <!-- ══ RESTYLE "JARVIS": sfondo animato, particelle luminose, orbe protagonista ══ -->
    <div id="bg-gradient" aria-hidden="true"></div>
    <canvas id="particles" aria-hidden="true"></canvas>
    <div id="orb" aria-hidden="true">
        <div class="orb-core"></div>
        <div class="orb-ring"></div>
        <div class="orb-ring ring-2"></div>
    </div>
    <div class="dock-beam" aria-hidden="true"></div>

    <div class="mesh-container">
        <div class="mesh-orb mesh-1"></div>
        <div class="mesh-orb mesh-2"></div>
        <div class="mesh-orb mesh-3"></div>
    </div>
    <div class="noise-surface"></div>

    <!-- Brain hero -->
    <div id="brain-main"></div>
    <div id="brain-glow"></div>
    <div id="audio-ring"></div>

    <!-- Hint permesso mic -->
    <div id="mic-hint" onclick="initAudio()">
        <div id="mic-hint-dot"></div>
        <span id="mic-hint-text">CLICCA PER ABILITARE IL MICROFONO</span>
    </div>

    <!-- Stato audio pill -->
    <div id="audio-status" onclick="initAudio()" title="Stato microfono browser">
        <div id="audio-status-dot"></div>
        <span id="audio-status-text">AUDIO OFF</span>
    </div>

    <!-- Logo angolo alto sinistra -->
    <div class="corner-logo" onclick="toggleMic()">
        <img src="clio_logo_official.png" alt="CLIO">
        <div>
            <div class="logo-text">CLIO</div>
            <div class="logo-acronym">
                <div class="logo-acronym-row"><b>C</b>ognitive</div>
                <div class="logo-acronym-row"><b>L</b>ink for</div>
                <div class="logo-acronym-row"><b>I</b>dea</div>
                <div class="logo-acronym-row"><b>O</b>ptimization</div>
            </div>
        </div>
    </div>

    <!-- Status badges -->
    <div class="status-strip">
        <div id="status-model"  class="badge" onclick="toggleModelSelector()"><i data-lucide="cpu"></i><span class="status-text">MODEL: AUTO</span></div>
        <div id="status-mic"    class="badge"><i data-lucide="mic"></i><span class="status-text">MIC: --</span></div>
        <div id="status-adb"    class="badge"><i data-lucide="smartphone"></i><span class="status-text">ADB: --</span></div>
        <div id="status-vision" class="badge"><i data-lucide="eye"></i><span class="status-text">HAWK EYE: --</span></div>
        <div id="status-cpu"    class="badge"><i data-lucide="cpu"></i><span class="status-text">CPU: --%</span></div>
        <div id="status-ram"    class="badge"><i data-lucide="memory-stick"></i><span class="status-text">RAM: --%</span></div>
        <div id="status-brain"  class="badge badge-active" onclick="toggleBrainLevel()" title="Intensità">
            <i data-lucide="brain-circuit"></i><span class="status-text">BRAIN: ON</span>
        </div>
        <div id="status-battery" class="badge">
            <i data-lucide="battery"></i><span class="status-text">BATT: --%</span>
        </div>
        <div id="status-voice" class="badge badge-active" onclick="toggleVoiceGender()" title="Cambia voce M/F" style="cursor:pointer">
            <i data-lucide="volume-2"></i><span class="status-text">♀ ISABELLA</span>
        </div>
    </div>

    <!-- Live Clock -->
    <div id="clock-widget">
        <div id="clock-time">00:00:00</div>
        <div id="clock-date">CARICAMENTO...</div>
    </div>

    <!-- Toast Notification Container -->
    <div id="toast-container"></div>

    <!-- Vision Panel -->
    <div id="vision-btn" onclick="toggleVisionPanel()" title="Vision Panel"><i data-lucide="eye"></i></div>
    <div id="vision-panel">
        <div id="vision-panel-header">
            <span id="vision-panel-label">👁 HAWK EYE</span>
            <span id="vision-age">—</span>
        </div>
        <img id="vision-img" src="" alt="Vision" style="display:none">
        <div id="vision-desc">In attesa di visione...</div>
    </div>

    <div class="action-history-ghost" id="ghost-history"></div>

    <div id="brain-info-card">
        <h3 id="brain-node-title">—</h3>
        <p  id="brain-node-desc">Connessione sinaptica attiva.</p>
    </div>

    <!-- Coding Panel -->
    <div id="coding-panel">
        <div id="coding-panel-header">
            <span id="coding-panel-title"><i data-lucide="code"></i> CODING TASK</span>
            <div id="coding-close" onclick="toggleCodingPanel()"><i data-lucide="x"></i></div>
        </div>
        <div id="coding-panel-body">
            <div class="coding-input-group">
                <span class="coding-label">Workspace Path (Opzionale)</span>
                <input type="text" id="coding-workspace" placeholder="C:\Users\User\Desktop\PROGETTI\clio">
            </div>
            <div class="coding-input-group">
                <span class="coding-label">Prompt / Task Description</span>
                <textarea id="coding-prompt" placeholder="Descrivi il task o incolla snippet di codice..."></textarea>
            </div>
            <div class="coding-actions">
                <button id="coding-start" class="coding-btn" onclick="startCodingTask()"><i data-lucide="play"></i> Avvia Task</button>
                <button id="coding-stop" class="coding-btn" onclick="stopCodingTask()"><i data-lucide="square"></i> Stop Task</button>
            </div>
            <div id="coding-output"></div>
        </div>
    </div>

    <!-- Model Selector -->
    <div id="model-selector" class="model-menu">
        <div class="model-option" onclick="forceModel('AUTO')">AUTO (Router)</div>
        <div class="model-option" onclick="forceModel('FAST')">FAST (Groq/Qwen)</div>
        <div class="model-option" onclick="forceModel('GENERAL')">GENERAL (Groq/Gemini)</div>
        <div class="model-option" onclick="forceModel('CODER')">CODER (Ollama/Qwen)</div>
        <div class="model-option" onclick="forceModel('VISION')">VISION (Gemini)</div>
    </div>

    <!-- Automations Panel -->
    <div id="automations-panel">
        <div id="automations-panel-header">
            <span id="automations-panel-title"><i data-lucide="list-tree"></i> AUTOMAZIONI CORTEX</span>
            <div id="automations-close" onclick="toggleAutomationsPanel()"><i data-lucide="x"></i></div>
        </div>
        <div id="automations-list">
            <div style="padding: 20px; text-align: center; color: rgba(255,255,255,0.4); font-size: 11px;">
                Caricamento automazioni...
            </div>
        </div>
    </div>

    <!-- Interaction dock -->
    <div class="interaction-dock">
        <div class="dock-main">
            <!-- Quick Actions Pills -->
            <div class="quick-actions" id="quick-actions">
                <div class="quick-pill" onclick="toggleAutomationsPanel()" title="Automazioni Cortex"><i data-lucide="list-tree" style="width:14px;height:14px;margin-right:4px"></i> Automazioni</div>
            </div>
            <div class="chat-history" id="chat-history"></div>
            <div class="speech-overlay" id="speech-box">
                <div class="speech-header">
                    <span class="clio-indicator">CLIO RISPONDE</span>
                    <div style="display:flex;gap:7px">
                        <button class="skip-btn" onclick="pinRisposta()"><i data-lucide="pin"></i></button>
                        <button class="skip-btn" onclick="stopSpeech()"><i data-lucide="square"></i><span>SKIP</span></button>
                    </div>
                </div>
                <div class="speech-content" id="speech-text"></div>
            </div>
        </div>
        <section class="command-center">
            <div class="input-container">
                <input type="text" id="clio-command" placeholder="Scrivi un comando per Clio..." onkeydown="if(event.key==='Enter')inviaComando()">
                <div class="input-actions">
                    <input type="file" id="img-upload" accept="image/*" style="display:none" onchange="inviaImmagine(this)">
                    <button class="action-btn" title="Coding Task" aria-label="Coding Task" onclick="toggleCodingPanel()"><i data-lucide="code"></i></button>
                    <button class="action-btn" title="Invia un'immagine" aria-label="Invia immagine" onclick="document.getElementById('img-upload').click()"><i data-lucide="image"></i></button>
                    <button class="action-btn" id="mic-btn" title="Comando vocale (o premi Spazio)" aria-label="Comando vocale" onclick="toggleMic()"><i data-lucide="mic"></i></button>
                    <button onclick="inviaComando()" class="send-btn" title="Invia messaggio (Invio)" aria-label="Invia messaggio"><i data-lucide="send"></i></button>
                </div>
            </div>
        </section>
    </div>

    <button class="recall-btn" onclick="pinRisposta()"><i data-lucide="message-circle"></i></button>

    <script src="/api/config.js"></script>
    <script>
    // ══════════════════════════════════════════════════════════
    //  GLOBALS
    // ══════════════════════════════════════════════════════════
    let syncLock = 0;          // Blocca setBrainVoice da aggiornaStati per N ms dopo azione locale
    let lastResponse = '';     // Ultima risposta Clio (per pin)
    let _chatHistoryIds = new Set(); // Tracking messaggi già renderizzati
    let _isProcessing = false;     // True SOLO mentre un task è davvero in elaborazione
    let _processingGen = 0;        // Generazione: invalida i poll vecchi
    let _thinkingTimer = null;     // Unico timer per l'animazione "Clio elabora..."

    // Autenticazione: il cookie di sessione clio_session è HttpOnly e viene inviato
    // automaticamente dal browser a ogni fetch same-origin. Nessun header manuale.

    // ══════════════════════════════════════════════════════════
    //  AUDIO ENGINE — Web Audio API reattivo in tempo reale
    // ══════════════════════════════════════════════════════════
    let audioAnalyser = null, audioData = null, audioCtx = null, micStream = null;
    let audioLevel = 0; // 0-1 smoothed

    function setAudioStatus(label, state) {
        const pill = document.getElementById('audio-status');
        const text = document.getElementById('audio-status-text');
        if(text) text.textContent = label;
        if(pill) {
            pill.classList.remove('audio-on', 'clio-on', 'mic-error');
            if(state) pill.classList.add(state);
        }
    }

    function micErrorMessage(error) {
        const name = error && error.name ? error.name : '';
        if(!window.isSecureContext) return 'Apri Clio da localhost o HTTPS per usare il microfono.';
        if(name === 'NotAllowedError' || name === 'PermissionDeniedError' || name === 'SecurityError')
            return 'Permesso negato: abilita il microfono nelle autorizzazioni del sito e ricarica.';
        if(name === 'NotFoundError' || name === 'DevicesNotFoundError') return 'Non trovo un microfono collegato.';
        if(name === 'NotReadableError' || name === 'TrackStartError') return 'Microfono occupato da un’altra app o non disponibile.';
        if(name === 'OverconstrainedError') return 'Il microfono selezionato non è disponibile.';
        return 'Microfono non disponibile: controlla dispositivo e permessi del browser.';
    }

    window.initAudio = async function() {
        const hint = document.getElementById('mic-hint');
        if(audioAnalyser) { hint.classList.add('hidden'); setAudioStatus('AUDIO ON', 'audio-on'); return true; }
        if(!window.isSecureContext || !navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
            const message = !window.isSecureContext
                ? micErrorMessage({name: 'SecurityError'})
                : 'Questo browser non supporta l’accesso al microfono. Apri Clio con Chrome o Edge aggiornato.';
            const hintText = document.getElementById('mic-hint-text');
            if(hintText) hintText.textContent = message;
            hint.classList.remove('hidden');
            setAudioStatus('MICROFONO NON DISPONIBILE', 'mic-error');
            return false;
        }
        try {
            const AudioContextClass = window.AudioContext || window.webkitAudioContext;
            if(!AudioContextClass) throw new Error('AudioContext non supportato');
            audioCtx    = new AudioContextClass();
            micStream   = await navigator.mediaDevices.getUserMedia({audio:true, video:false});
            if(audioCtx.state === 'suspended') await audioCtx.resume();
            audioAnalyser = audioCtx.createAnalyser();
            audioAnalyser.fftSize = 64;
            audioAnalyser.smoothingTimeConstant = 0.75;
            audioData   = new Uint8Array(audioAnalyser.frequencyBinCount);
            const src   = audioCtx.createMediaStreamSource(micStream);
            src.connect(audioAnalyser);
            hint.classList.add('hidden');
            setAudioStatus('AUDIO ON', 'audio-on');
            startAudioLoop();
            return true;
        } catch(e) {
            if(micStream) micStream.getTracks().forEach(track => track.stop());
            micStream = null;
            audioAnalyser = null;
            if(audioCtx) { audioCtx.close().catch(() => {}); audioCtx = null; }
            const message = micErrorMessage(e);
            const hintText = document.getElementById('mic-hint-text');
            if(hintText) hintText.textContent = message;
            hint.classList.remove('hidden');
            setAudioStatus('MICROFONO NON DISPONIBILE', 'mic-error');
            setTimeout(() => hint.classList.add('hidden'), 7000);
            return false;
        }
    };

    function getRawLevel() {
        if(!audioAnalyser) return 0;
        audioAnalyser.getByteFrequencyData(audioData);
        let sum = 0;
        for(let i = 0; i < audioData.length; i++) sum += audioData[i];
        return (sum / audioData.length) / 128; // 0-2
    }

    function startAudioLoop() {
        const glow   = document.getElementById('brain-glow');
        const ring   = document.getElementById('audio-ring');
        let prevLevel = 0;

        // Aggiorna pill: AUDIO ON
        setAudioStatus('AUDIO ON', 'audio-on');

        function tick() {
            const raw = getRawLevel();
            audioLevel = raw > prevLevel
                ? raw * 0.6  + prevLevel * 0.4   // attack rapido
                : raw * 0.05 + prevLevel * 0.95; // decay lento
            prevLevel = audioLevel;

            const lvl = Math.min(audioLevel, 1);

            // Glow overlay
            glow.style.opacity = (lvl * 0.85).toFixed(3);

            // Ring: scala attorno al centro via transform (nessun conflitto CSS)
            const s = 1 + lvl * 1.4;
            const alpha = lvl * 0.75;
            ring.style.transform   = `scale(${s.toFixed(3)})`;
            ring.style.borderColor = `rgba(0,191,255,${alpha.toFixed(3)})`;
            ring.style.borderWidth = (1.5 + lvl * 2).toFixed(1) + 'px';
            ring.style.boxShadow   = alpha > 0.05
                ? `0 0 ${(lvl*50).toFixed(0)}px rgba(0,191,255,${(alpha*0.6).toFixed(3)})`
                : 'none';

            requestAnimationFrame(tick);
        }
        tick();
    }

    // ══════════════════════════════════════════════════════════
    //  BRAIN — 3D Force Graph con illuminazione ciano custom
    // ══════════════════════════════════════════════════════════
    try {  /* STEP5C: isola il brain 3D — se i CDN (THREE/ForceGraph) non caricano, non deve bloccare stato/mic/timer */
    (function(){
        // Autenticazione via cookie di sessione HttpOnly (inviato automaticamente).

        const G = ForceGraph3D({rendererConfig:{alpha:true, antialias:true}})(document.getElementById('brain-main'))
            .backgroundColor('rgba(0,0,0,0)')
            .nodeThreeObject(n => {
                const col = n.color || '#00BFFF';
                const radius = Math.cbrt(n.val || 5) * 3.5;
                const mesh = new THREE.Mesh(
                    new THREE.SphereGeometry(radius, 18, 18),
                    new THREE.MeshBasicMaterial({ color: col, transparent: true, opacity: 0.92 })
                );
                // Glow sprite sovrapposto
                const spriteMat = new THREE.SpriteMaterial({
                    color: col, transparent: true, opacity: 0.18,
                    depthWrite: false, blending: THREE.AdditiveBlending
                });
                const sprite = new THREE.Sprite(spriteMat);
                sprite.scale.set(radius * 5, radius * 5, 1);
                mesh.add(sprite);
                return mesh;
            })
            .nodeThreeObjectExtend(false)
            .nodeLabel(n => `<span style="color:#00BFFF;font-family:Outfit,sans-serif;font-weight:700;font-size:12px">${n.name}</span>`)
            .linkColor(() => 'rgba(0,191,255,0.2)')
            .linkWidth(0.6)
            .linkOpacity(0.6)
            .onNodeClick(n => {
                document.getElementById('brain-node-title').innerText = n.name || '—';
                document.getElementById('brain-node-desc').innerText  = n.desc || 'Connessione sinaptica attiva.';
                const c = document.getElementById('brain-info-card');
                c.classList.add('visible');
                setTimeout(() => c.classList.remove('visible'), 7000);
            });

        // ── Sostituisci luci default (bianche) con luci ciano ──
        const scene = G.scene();
        // Rimuovi tutte le luci di default aggiunte da 3d-force-graph
        scene.children.filter(c => c.isLight).forEach(l => scene.remove(l));
        // Luce ambiente buia (non lava i colori)
        scene.add(new THREE.AmbientLight(0x000818, 2));
        // Point light ciano al centro — illumina le sfere di blu/ciano
        const cyanLight = new THREE.PointLight(0x00BFFF, 12, 700);
        cyanLight.position.set(0, 0, 0);
        scene.add(cyanLight);
        // Soft fill da dietro per profondità
        const fillLight = new THREE.PointLight(0x4400ff, 3, 500);
        fillLight.position.set(-150, 100, -200);
        scene.add(fillLight);

        // ── Animazione fluida (rAF, sincronizzata col refresh) ──
        // Un solo loop requestAnimationFrame per rotazione + breathing + luce:
        // niente scatti da setInterval, movimento time-based e sempre regolare.
        let angle = 0;
        let baseRotSpeed = 0.09;     // rad/s a riposo (ex 0.0015 per frame @16ms)
        let breathPhase = 0;
        let breathSpeed = 0.55;      // rad/s a riposo → pulse lento e morbido
        let smoothSc = 1;            // scala nodi con easing
        let smoothLight = 12;        // intensità luce con easing
        let lastFrame = performance.now();

        function animateBrain(now) {
            const dt = Math.min((now - lastFrame) / 1000, 0.05); // secondi (clamp anti-salto)
            lastFrame = now;
            const lvl = Math.min(audioLevel, 1);

            // Rotazione camera continua e fluida (accelera con la voce)
            angle += (baseRotSpeed + lvl * 0.5) * dt;
            G.cameraPosition({x: 220 * Math.sin(angle), z: 220 * Math.cos(angle)});

            // Breathing: sinusoide continua (mai scatti) + reazione alla voce
            breathPhase += (breathSpeed + lvl * 2.0) * dt;
            const amp = 0.05 + lvl * 0.28;
            const target = 1 + Math.sin(breathPhase) * amp + lvl * 0.06;
            smoothSc += (target - smoothSc) * 0.12; // easing esponenziale
            try {
                G.scene().traverse(obj => {
                    if(obj.isMesh && obj.material && obj.material.isMeshBasicMaterial && !obj.isSprite) {
                        obj.scale.setScalar(smoothSc);
                    }
                });
            } catch(e) {}

            // Luce ciano: pulsazione morbida con la voce
            smoothLight += ((12 + lvl * 20) - smoothLight) * 0.1;
            cyanLight.intensity = smoothLight;

            requestAnimationFrame(animateBrain);
        }
        requestAnimationFrame(animateBrain);

        // ── API voice state ──
        window._brainSetListening = function(on) {
            baseRotSpeed = on ? 0.28 : 0.09;  // rad/s
            breathSpeed  = on ? 1.1  : 0.55;  // rad/s
        };

        // Fetch memory graph
        async function fb() {
            try {
                const r = await fetch('/api/memory_graph');
                const d = await r.json();
                G.graphData({nodes: d.nodes||[], links: d.links||[]});
            } catch(e) {}
        }
        fb(); setInterval(fb, 30000);
    })();
    } catch(e){ console.warn('[CLIO] Brain 3D disattivato (probabile CDN THREE/ForceGraph non caricato). La UI resta funzionante:', e); }

    // Brain toggle livelli
    let brainLvl = 0;
    const brainOps = [1, 0.45, 0], brainTxt = ['BRAIN: ON','BRAIN: DIM','BRAIN: OFF'];
    function toggleBrainLevel() {
        brainLvl = (brainLvl+1) % 3;
        document.getElementById('brain-main').style.opacity = brainOps[brainLvl];
        document.querySelector('#status-brain .status-text').innerText = brainTxt[brainLvl];
    }

    // ══════════════════════════════════════════════════════════
    //  HUB — Comunicazione con Clio
    // ══════════════════════════════════════════════════════════

    // Voice gender toggle
    async function toggleVoiceGender() {
        const badge = document.getElementById('status-voice');
        const txt   = badge.querySelector('.status-text');
        try {
            const r = await fetch('/api/voice/toggle', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'}
            });
            if (!r.ok) {
                console.error('Voice toggle HTTP error:', r.status, await r.text());
                txt.innerText = '⚠ ERR ' + r.status;
                return;
            }
            const d = await r.json();
            if(d.gender === 'male') {
                txt.innerText = '♂ DIEGO';
                badge.style.borderColor = 'rgba(168,85,247,0.45)';
                badge.style.color = '#a855f7';
            } else {
                txt.innerText = '♀ ISABELLA';
                badge.style.borderColor = '';
                badge.style.color = '';
            }
        } catch(e) {
            console.error('Voice toggle error:', e);
            txt.innerText = '⚠ ERRORE';
        }
    }

    function setBrainVoice(on) {
        document.body.classList.toggle('brain-listening', on);
        if(window._brainSetListening) window._brainSetListening(on);
        // Mic button
        const mb = document.getElementById('mic-btn');
        if(mb) mb.classList.toggle('mic-active', on);
        // Audio status pill
        if(on) {
            setAudioStatus('CLIO ASCOLTA', 'clio-on');
        } else if(audioAnalyser) {
            setAudioStatus('AUDIO ON', 'audio-on');
        } else {
            setAudioStatus('AUDIO OFF', '');
        }
    }

    function addHistoryAction(t) {
        const g = document.getElementById('ghost-history'), i = document.createElement('div');
        i.className = 'history-item';
        i.innerHTML = `<i data-lucide="send"></i><span>${t}</span>`;
        g.appendChild(i); lucide.createIcons();
        setTimeout(() => i.remove(), 8000);
    }

    async function aggiornaStati() {
        try {
            const s = await (await fetch('/api/status')).json();
            if('serviceWorker' in navigator) navigator.serviceWorker.register('service-worker.js').catch(()=>{});

            // Helper unico: imposta classe di stato + etichetta leggibile
            const setBadge = (id, cls, text) => {
                const b = document.getElementById(id);
                if(b){ b.className = 'badge ' + cls; const t = b.querySelector('.status-text'); if(t) t.innerText = text; }
            };
            const isOk = v => v === true || ['connected','active','ok','online','listening'].includes(String(v).toLowerCase());

            // Aggiorna Badge Modello
            if(s.current_model) {
                const modelBadge = document.querySelector('#status-model .status-text');
                if(modelBadge) modelBadge.innerText = 'MODEL: ' + s.current_model.toUpperCase();
            }

            // Connessioni: verde se attive, giallo se assenti (attenzione), grigio se spente
            setBadge('status-adb',    isOk(s.adb)    ? 'badge-ok' : 'badge-warn',
                                      isOk(s.adb)    ? 'ADB: ONLINE' : 'ADB: OFFLINE');
            setBadge('status-vision', isOk(s.vision) ? 'badge-ok' : 'badge-idle',
                                      isOk(s.vision) ? 'HAWK EYE: ATTIVO' : 'HAWK EYE: SPENTO');

            // Microfono: verde quando Clio ascolta, rosso se muto, grigio se spento
            const ms = s.privacy_mode ? 'muted' : (s.mic || 'inactive');
            if(ms === 'listening')    setBadge('status-mic', 'badge-ok',   'MIC: TI ASCOLTO');
            else if(ms === 'muted')   setBadge('status-mic', 'badge-crit', 'MIC: MUTO');
            else if(ms === 'active')  setBadge('status-mic', 'badge-ok',   'MIC: PRONTO');
            else                      setBadge('status-mic', 'badge-idle', 'MIC: SPENTO');

            if(Date.now() > syncLock) setBrainVoice(ms === 'listening');
            // Feedback wake-word: indicatore esplicito mentre Clio ascolta dopo "Ehi Clio"
            if(ms === 'listening') setAudioStatus('🎤 TI ASCOLTO...', 'clio-on');

            if(s.telemetria) {
                const cpu = s.telemetria.cpu_percent||0, ram = s.telemetria.ram_percent||0;
                const batt = s.telemetria.battery_percent;
                const plugged = s.telemetria.power_plugged;
                // Verde <60%, giallo 60-84%, rosso >=85%
                const livCls = v => v >= 85 ? 'badge-crit' : v >= 60 ? 'badge-warn' : 'badge-ok';
                setBadge('status-cpu', livCls(cpu), `CPU: ${cpu}%`);
                setBadge('status-ram', livCls(ram), `RAM: ${ram}%`);
                if(batt !== undefined) {
                    const bCls = batt < 20 ? 'badge-crit' : batt < 50 ? 'badge-warn' : 'badge-ok';
                    setBadge('status-battery', bCls, `BATT: ${batt}%${plugged ? ' ⚡' : ''}`);
                }
            }

            // Automazioni
            if (s.automations && Array.isArray(s.automations)) {
                _lastAutomationsData = s.automations;
                if (_automationsOpen) renderAutomations();
            }

            const sb = document.getElementById('speech-box'), st = document.getElementById('speech-text');
            if(s.last_speech && s.last_speech.trim()) {
                const newSpeech = s.last_speech;
                if(st.dataset.lastSpeech !== newSpeech) {
                    st.dataset.lastSpeech = newSpeech;
                    typewriterEffect(st, newSpeech, 18);
                }
                sb.classList.add('active');
            } else {
                sb.classList.remove('active');
            }

            // Mostra toast per notifiche proattive di Clio
            if(s.notifications && s.notifications.length > 0) {
                s.notifications.forEach(n => showToast(n.text, n.type || 'proactive'));
            }

            // Sicurezza: "Clio elabora..." non deve MAI restare se non c'è un task attivo
            if(!_isProcessing) {
                const inp2 = document.getElementById('clio-command');
                if(inp2 && /elabora/i.test(inp2.placeholder)) inp2.placeholder = 'Scrivi un comando per Clio...';
            }

            lucide.createIcons();
        } catch(e) {}
    }

    // ── Carica cronologia chat dal server (persistente tra refresh) ──
    async function loadChatHistory() {
        try {
            const r = await fetch('/api/chat_history?limit=20');
            if(!r.ok) return;
            const d = await r.json();
            const msgs = d.history || [];
            msgs.forEach(m => {
                const key = m.ts + m.role + m.text.slice(0,20);
                if(!_chatHistoryIds.has(key)) {
                    _chatHistoryIds.add(key);
                    _renderChatMsg(m.role, m.text, m.ts);
                }
            });
        } catch(e) {}
    }

    function _renderChatMsg(role, text, ts='') {
        const h = document.getElementById('chat-history');
        const m = document.createElement('div');
        m.className = `chat-msg chat-msg-${role}`;
        const label = role === 'user' ? 'TU' : 'CLIO';
        const tsStr = ts ? `<span style="font-size:9px;opacity:0.3;margin-left:6px">${ts}</span>` : '';
        m.innerHTML = `<div class="chat-bubble"><span class="chat-role">${label}${tsStr}</span><p>${text}</p></div>`;
        h.appendChild(m);
        h.scrollTop = h.scrollHeight;
    }

    window.stopSpeech = async () => {
        try { await fetch('/api/speech/stop',{method:'POST'}); document.getElementById('speech-box').classList.remove('active'); } catch(e) {}
    };

    // ── PUSH-TO-TALK (Web Speech API) ──────────────────────────
    let _ptt = null;       // SpeechRecognition instance
    let _pttActive = false;

    function speechErrorMessage(code) {
        if(code === 'no-speech') return 'Non ho sentito parole: avvicinati al microfono e riprova.';
        if(code === 'not-allowed' || code === 'service-not-allowed') return 'Accesso al microfono negato: abilitalo nelle autorizzazioni del browser.';
        if(code === 'audio-capture') return 'Microfono non trovato o occupato da un’altra app.';
        if(code === 'network') return 'Riconoscimento vocale non raggiungibile: controlla la connessione.';
        if(code === 'language-not-supported') return 'Riconoscimento italiano non supportato dal browser.';
        return 'Errore di riconoscimento (' + (code || 'sconosciuto') + '). Riprova.';
    }

    function _pttInit() {
        const SR = window.SpeechRecognition || window.webkitSpeechRecognition;
        if (!SR) {
            const inp = document.getElementById('clio-command');
            if(inp) inp.placeholder = 'Voce non supportata: prova con Chrome o Edge.';
            setAudioStatus('VOCE NON SUPPORTATA', 'mic-error');
            return null;
        }
        const r = new SR();
        r.lang = 'it-IT';
        r.continuous = false;
        r.interimResults = true;
        r._finalTranscript = '';
        r._lastError = '';

        const inp = document.getElementById('clio-command');
        const btn = document.getElementById('mic-btn');

        r.onstart = () => {
            _pttActive = true;
            setBrainVoice(true);
            if(btn) btn.classList.add('mic-active');
            inp.placeholder = '🎙 Sto ascoltando...';
        };

        r.onresult = (e) => {
            let interim = '';
            for(let i = e.resultIndex; i < e.results.length; i++) {
                const result = e.results[i];
                const transcript = result[0].transcript.trim();
                if(result.isFinal && transcript) r._finalTranscript = (r._finalTranscript + ' ' + transcript).trim();
                else interim += (interim ? ' ' : '') + transcript;
            }
            inp.value = [r._finalTranscript, interim].filter(Boolean).join(' ');
        };

        r.onend = async () => {
            _pttActive = false;
            setBrainVoice(false);
            if(btn) btn.classList.remove('mic-active');
            const testo = (r._finalTranscript || '').trim();
            if (testo) {
                inp.value = testo;
                await _pttInviaComando(testo);
            } else {
                inp.value = '';
                inp.disabled = false;
                inp.placeholder = r._lastError ? speechErrorMessage(r._lastError) : 'Non ho sentito parole: riprova.';
                if(r._lastError) setAudioStatus('ERRORE MICROFONO', 'mic-error');
            }
        };

        r.onerror = (e) => {
            r._lastError = e.error || 'unknown';
            console.warn('Speech error:', r._lastError);
        };

        return r;
    }

    async function _pttInviaComando(cmd) {
        const inp = document.getElementById('clio-command');
        inp.value = ''; inp.placeholder = 'Elaborazione...'; inp.disabled = true;
        addChatMessage('user', cmd);
        try {
            const r = await fetch('/api/command', {
                method: 'POST',
                headers: {'Content-Type':'application/json'},
                body: JSON.stringify({text: cmd})
            });
            const d = await r.json();
            if (d.status === 'accepted' && d.task_id) pollTaskStatus(d.task_id);
            else { inp.placeholder = 'Errore invio.'; inp.disabled = false; }
        } catch(e) { inp.placeholder = 'Errore di connessione.'; inp.disabled = false; }
    }

    window.toggleMic = async () => {
        if(!audioAnalyser) await initAudio();

        if (_pttActive) {
            // Secondo click: ferma ascolto
            if (_ptt) _ptt.stop();
            return;
        }

        if(!audioAnalyser) return;

        // Primo click: avvia ascolto
        if (!_ptt) _ptt = _pttInit();
        if (!_ptt) return;
        _ptt._finalTranscript = '';
        _ptt._lastError = '';
        document.getElementById('clio-command').value = '';
        try { _ptt.start(); }
        catch(e) {
            console.error('Avvio microfono fallito:', e);
            _pttActive = false;
            setBrainVoice(false);
            setAudioStatus('ERRORE MICROFONO', 'mic-error');
            document.getElementById('clio-command').placeholder = 'Microfono occupato: chiudi le altre app e riprova.';
        }
    };

    async function inviaComando() {
        const inp = document.getElementById('clio-command'), cmd = inp.value.trim();
        if(!cmd) return;
        const orig = cmd; inp.value=''; inp.placeholder='Elaborazione...'; inp.disabled=true;
        try {
            const r = await fetch('/api/command',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({text:cmd})});
            const d = await r.json();
            if(d.status==='accepted' && d.task_id) { addHistoryAction(orig); addChatMessage('user',orig); pollTaskStatus(d.task_id); }
            else { inp.placeholder='Errore invio.'; inp.disabled=false; }
        } catch(e) { inp.placeholder='Errore di connessione.'; inp.disabled=false; }
    }

    async function pollTaskStatus(tid) {
        const inp = document.getElementById('clio-command');
        const sb = document.getElementById('speech-box');
        const st = document.getElementById('speech-text');
        setBrainVoice(true);
        syncLock = Date.now() + 30000; // Blocca override da status poll per 30s

        // Stato di elaborazione REALE: la scritta appare solo ora.
        _isProcessing = true;
        const myGen = ++_processingGen;
        if(_thinkingTimer) clearInterval(_thinkingTimer);
        let dots = 0;
        _thinkingTimer = setInterval(() => {
            if(!_isProcessing || myGen !== _processingGen) return;
            dots = (dots + 1) % 4;
            inp.placeholder = 'Clio elabora' + '.'.repeat(dots + 1);
        }, 400);

        // Chiude SEMPRE l'elaborazione: ferma i puntini e ripristina l'input.
        const fineElaborazione = () => {
            _isProcessing = false;
            if(_thinkingTimer){ clearInterval(_thinkingTimer); _thinkingTimer = null; }
            inp.disabled = false;
            inp.placeholder = 'Scrivi un comando per Clio...';
        };

        const startedAt = Date.now();
        const TIMEOUT_MS = 180000; // 3 min: evita "Clio elabora..." infinito

        const poll = async () => {
            if(myGen !== _processingGen || !_isProcessing) return; // poll superato da un nuovo task
            if(Date.now() - startedAt > TIMEOUT_MS) {
                setBrainVoice(false);
                syncLock = 0;
                fineElaborazione();
                st.textContent = 'Il task sta impiegando troppo tempo. Riprova.';
                sb.classList.add('active');
                return;
            }
            try {
                const r = await fetch(`/api/task_status/${tid}`);
                const d = await r.json();
                const stato = String(d.status || '').toLowerCase();
                if(['completed','done','success','finished','error','failed'].includes(stato)) {
                    setBrainVoice(false);
                    syncLock = 0;
                    fineElaborazione();
                    const txt = d.response || (stato.includes('error') || stato === 'failed' ? 'Errore nel completare il task.' : '');
                    st.textContent=txt; lastResponse=txt;
                    addChatMessage('clio', txt);
                    sb.classList.add('active');
                    return;
                }
                setTimeout(poll, 800);
            } catch(e) {
                setBrainVoice(false);
                syncLock = 0;
                fineElaborazione();
                inp.placeholder='Errore di connessione.';
            }
        };
        poll();
    }

    function addChatMessage(role, text) {
        const now = new Date().toLocaleTimeString('it-IT', {hour:'2-digit',minute:'2-digit'});
        const key = now + role + text.slice(0,20);
        if(_chatHistoryIds.has(key)) return; // Evita duplicati
        _chatHistoryIds.add(key);
        _renderChatMsg(role, text, now);
        lucide.createIcons();
    }

    async function inviaImmagine(input) {
        const file = input.files[0]; if(!file) return;
        const cap = prompt('Descrizione per Clio:','Cosa vedi in questa immagine?');
        const reader = new FileReader();
        reader.onload = async e => {
            const b64 = e.target.result.split(',')[1]; addChatMessage('user',`[Immagine: ${file.name}]`);
            try { const r=await fetch('/api/command',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({text:cap||'Cosa vedi?',image_base64:b64,image_type:file.type})}); const d=await r.json(); if(d.task_id) pollTaskStatus(d.task_id); }
            catch(e) { addChatMessage('clio','Errore invio immagine.'); }
        };
        reader.readAsDataURL(file); input.value='';
    }

    function pinRisposta() {
        if(!lastResponse) return;
        document.getElementById('speech-text').textContent = lastResponse;
        document.getElementById('speech-box').classList.add('active');
    }

    // ══════════════════════════════════════════════════════════
    //  LIVE CLOCK
    // ══════════════════════════════════════════════════════════
    function updateClock() {
        const now = new Date();
        const t = now.toLocaleTimeString('it-IT', {hour:'2-digit', minute:'2-digit', second:'2-digit'});
        const d = now.toLocaleDateString('it-IT', {weekday:'long', day:'numeric', month:'long', year:'numeric'});
        document.getElementById('clock-time').textContent = t;
        document.getElementById('clock-date').textContent = d.toUpperCase();
    }
    setInterval(updateClock, 1000); updateClock();

    // ══════════════════════════════════════════════════════════
    //  TOAST NOTIFICATIONS
    // ══════════════════════════════════════════════════════════
    function showToast(text, type='proactive') {
        const container = document.getElementById('toast-container');
        const toast = document.createElement('div');
        const label = type === 'security' ? '🚨 ALERT SICUREZZA' : '🔔 CLIO DICE';
        toast.className = `toast${type === 'security' ? ' toast-security' : ''}`;
        toast.innerHTML = `<div class="toast-label">${label}</div><p>${text}</p>`;
        toast.onclick = () => toast.remove();
        container.appendChild(toast);
        requestAnimationFrame(() => { requestAnimationFrame(() => toast.classList.add('visible')); });
        setTimeout(() => {
            toast.classList.remove('visible');
            setTimeout(() => { if(toast.parentNode) toast.remove(); }, 500);
        }, 8000);
    }

    // ══════════════════════════════════════════════════════════
    //  QUICK ACTIONS
    // ══════════════════════════════════════════════════════════
    const QUICK_ACTIONS_DEF = [
        { e: '☀️', l: 'Briefing',    c: '__briefing__' },
        { e: '📰', l: 'Notizie',     c: 'Dammi le ultime notizie ANSA' },
        { e: '⛅', l: 'Meteo',       c: 'Com\'è il meteo oggi?' },
        { e: '💻', l: 'Stato PC',    c: 'Dimmi CPU, RAM e stato del PC' },
        { e: '📧', l: 'Email',       c: 'Leggi le mie ultime email' },
        { e: '📅', l: 'Agenda',      c: 'Cosa ho in agenda oggi?' },
        { e: '🎵', l: 'Play/Pausa',  c: 'play pausa musica' },
        { e: '🔇', l: 'Muta',        c: 'muta il volume' },
        { e: '📸', l: 'Screenshot',  c: 'fai screenshot e dimmi cosa vedi' },
        { e: '🔒', l: 'Blocca PC',   c: 'blocca il pc' },
    ];

    function initQuickActions() {
        const container = document.getElementById('quick-actions');
        QUICK_ACTIONS_DEF.forEach(qa => {
            const pill = document.createElement('div');
            pill.className = 'quick-pill';
            pill.innerHTML = `<span>${qa.e}</span><span>${qa.l}</span>`;
            pill.onclick = () => quickAction(qa.c, qa.l);
            container.appendChild(pill);
        });
    }

    async function quickAction(cmd, label) {
        if(cmd === '__briefing__') { await loadBriefing(); return; }
        // Usa quick_command (risposta immediata) per azioni fast
        addChatMessage('user', cmd);
        addHistoryAction(label);
        const inp = document.getElementById('clio-command');
        inp.disabled = true; inp.placeholder = `${label}...`;
        try {
            const r = await fetch('/api/quick_command', {
                method: 'POST',
                headers: {'Content-Type':'application/json'},
                body: JSON.stringify({cmd})
            });
            const d = await r.json();
            inp.disabled = false; inp.placeholder = 'Scrivi un comando per Clio...';
            if(d.response) {
                addChatMessage('clio', d.response);
                typewriterEffect(document.getElementById('speech-text'), d.response);
                document.getElementById('speech-box').classList.add('active');
                lastResponse = d.response;
            }
        } catch(e) {
            inp.disabled = false; inp.placeholder = 'Errore connessione.';
        }
    }

    async function loadBriefing() {
        const inp = document.getElementById('clio-command');
        inp.placeholder = 'Caricamento briefing...';
        try {
            const r = await fetch('/api/briefing');
            const d = await r.json();
            const txt = d.briefing || 'Briefing non disponibile.';
            addChatMessage('clio', txt);
            typewriterEffect(document.getElementById('speech-text'), txt);
            document.getElementById('speech-box').classList.add('active');
            lastResponse = txt;
        } catch(e) {}
        inp.placeholder = 'Scrivi un comando per Clio...';
    }

    initQuickActions();

    // ══════════════════════════════════════════════════════════
    //  TYPEWRITER EFFECT
    // ══════════════════════════════════════════════════════════
    let _twTimer = null;
    function typewriterEffect(el, text, speed = 16) {
        if(_twTimer) clearInterval(_twTimer);
        el.innerHTML = '';
        const cursor = document.createElement('span');
        cursor.className = 'typewriter-cursor';
        el.appendChild(cursor);
        let i = 0;
        _twTimer = setInterval(() => {
            if(i < text.length) {
                el.insertBefore(document.createTextNode(text[i++]), cursor);
                el.parentElement.scrollTop = el.parentElement.scrollHeight;
            } else {
                clearInterval(_twTimer); _twTimer = null;
                cursor.style.display = 'none'; // Rimuovi cursore a fine testo
            }
        }, speed);
    }

    // ══════════════════════════════════════════════════════════
    //  VISION PANEL
    // ══════════════════════════════════════════════════════════
    let _visionOpen = false;

    // ══════════════════════════════════════════════════════════
    //  CODING PANEL
    // ══════════════════════════════════════════════════════════
    let _codingOpen = false;
    let _currentCodingTaskId = null;
    let _codingPollTimer = null;

    function toggleCodingPanel() {
        _codingOpen = !_codingOpen;
        document.getElementById('coding-panel').classList.toggle('open', _codingOpen);
        if(_codingOpen) document.getElementById('coding-prompt').focus();
    }

    async function startCodingTask() {
        const prompt = document.getElementById('coding-prompt').value.trim();
        const workspace = document.getElementById('coding-workspace').value.trim();
        if(!prompt) return;
        
        let fullPrompt = "coding task: " + prompt;
        if(workspace) fullPrompt += "\nWorkspace: " + workspace;
        
        const out = document.getElementById('coding-output');
        out.style.display = 'block';
        out.textContent = 'Avvio task in corso...\n';
        document.getElementById('coding-start').style.display = 'none';
        document.getElementById('coding-stop').style.display = 'flex';
        
        try {
            const r = await fetch('/api/command', {
                method: 'POST',
                headers: {'Content-Type':'application/json'},
                body: JSON.stringify({text: fullPrompt})
            });
            const d = await r.json();
            if(d.status === 'accepted' && d.task_id) {
                _currentCodingTaskId = d.task_id;
                pollCodingTaskStatus(d.task_id);
            } else {
                out.textContent += '\nErrore avvio task.';
                resetCodingButtons();
            }
        } catch(e) {
            out.textContent += '\nErrore di connessione al backend.';
            resetCodingButtons();
        }
    }

    async function pollCodingTaskStatus(tid) {
        if(tid !== _currentCodingTaskId) return;
        try {
            const r = await fetch(`/api/task_status/${tid}`);
            const d = await r.json();
            const stato = String(d.status || '').toLowerCase();
            
            if(['completed','done','success','finished','error','failed'].includes(stato)) {
                const out = document.getElementById('coding-output');
                out.textContent += '\n\n[TASK COMPLETATO]\n' + (d.response || '');
                out.scrollTop = out.scrollHeight;
                resetCodingButtons();
                return;
            }
            
            const out = document.getElementById('coding-output');
            if(!out.textContent.endsWith('...')) out.textContent += '.';
            out.scrollTop = out.scrollHeight;
            
            _codingPollTimer = setTimeout(() => pollCodingTaskStatus(tid), 1500);
        } catch(e) {
            document.getElementById('coding-output').textContent += '\nErrore durante il polling dello stato.';
            resetCodingButtons();
        }
    }

    function stopCodingTask() {
        _currentCodingTaskId = null;
        if(_codingPollTimer) clearTimeout(_codingPollTimer);
        document.getElementById('coding-output').textContent += '\n\n[TASK INTERROTTO DALLA UI]';
        resetCodingButtons();
    }

    function resetCodingButtons() {
        document.getElementById('coding-start').style.display = 'flex';
        document.getElementById('coding-stop').style.display = 'none';
        _currentCodingTaskId = null;
    }

    // ══════════════════════════════════════════════════════════
    //  MODEL MENU
    // ══════════════════════════════════════════════════════════
    let _modelMenuOpen = false;

    function toggleModelSelector() {
        _modelMenuOpen = !_modelMenuOpen;
        document.getElementById('model-selector').classList.toggle('open', _modelMenuOpen);
    }

    async function forceModel(modelName) {
        toggleModelSelector();
        try {
            await fetch('/api/model/force', {
                method: 'POST',
                headers: {'Content-Type':'application/json'},
                body: JSON.stringify({model: modelName})
            });
            // Update UI optimistically
            document.querySelector('#status-model .status-text').innerText = 'MODEL: ' + modelName;
        } catch(e) {
            console.error('Error forcing model:', e);
        }
    }

    // ══════════════════════════════════════════════════════════
    //  AUTOMATIONS PANEL
    // ══════════════════════════════════════════════════════════
    let _automationsOpen = false;
    let _lastAutomationsData = [];

    function toggleAutomationsPanel() {
        _automationsOpen = !_automationsOpen;
        document.getElementById('automations-panel').classList.toggle('open', _automationsOpen);
        if(_automationsOpen) renderAutomations();
    }

    function renderAutomations() {
        const listContainer = document.getElementById('automations-list');
        if (!_lastAutomationsData || _lastAutomationsData.length === 0) {
            listContainer.innerHTML = '<div style="padding:20px;text-align:center;color:rgba(255,255,255,0.4);font-size:11px;">Nessuna automazione trovata o caricamento in corso...</div>';
            return;
        }

        let html = '';
        _lastAutomationsData.forEach(aut => {
            const isRo = aut.class === 'read-only' || aut.class === 'reversibile';
            const badgeClass = isRo ? 'badge-ro' : 'badge-rw';
            const badgeText = isRo ? 'SAFE' : 'IRREVERSIBILE';
            
            html += `
                <div class="automation-item">
                    <div class="automation-info">
                        <span class="automation-name">${aut.label || aut.name}</span>
                        <span class="automation-badge ${badgeClass}">${badgeText}</span>
                    </div>
                    <button class="automation-btn" onclick="executeAutomation('${aut.name}', '${aut.label || aut.name}')">
                        Esegui
                    </button>
                </div>
            `;
        });
        
        listContainer.innerHTML = html;
    }

    async function executeAutomation(name, label) {
        toggleAutomationsPanel();
        addChatMessage('user', `Esegui automazione: ${label}`);
        addHistoryAction(label);
        
        const inp = document.getElementById('clio-command');
        inp.disabled = true; 
        inp.placeholder = `Esecuzione ${label}...`;
        
        try {
            // Usa l'endpoint command standard chiedendo esplicitamente di eseguire il tool
            const r = await fetch('/api/command', {
                method: 'POST',
                headers: {'Content-Type':'application/json'},
                body: JSON.stringify({text: `Esegui il tool di automazione chiamato ${name}`})
            });
            const d = await r.json();
            if(d.status === 'accepted' && d.task_id) {
                pollTaskStatus(d.task_id);
            } else {
                inp.disabled = false;
                inp.placeholder = 'Errore invio automazione.';
            }
        } catch(e) {
            inp.disabled = false;
            inp.placeholder = 'Errore connessione.';
        }
    }

    // Close menu when clicking outside

    document.addEventListener('click', (e) => {
        if(_modelMenuOpen && !e.target.closest('#status-model') && !e.target.closest('#model-selector')) {
            toggleModelSelector();
        }
    });

    function toggleVisionPanel() {
        _visionOpen = !_visionOpen;
        const panel = document.getElementById('vision-panel');
        const btn = document.getElementById('vision-btn');
        panel.classList.toggle('open', _visionOpen);
        btn.classList.toggle('active', _visionOpen);
        if(_visionOpen) refreshVision();
    }

    async function refreshVision() {
        if(!_visionOpen) return;
        try {
            const r = await fetch('/api/vision');
            const d = await r.json();
            const img = document.getElementById('vision-img');
            const desc = document.getElementById('vision-desc');
            const age = document.getElementById('vision-age');
            if(d.vision) {
                img.src = 'data:image/png;base64,' + d.vision;
                img.style.display = 'block';
            }
            if(d.desc) desc.textContent = d.desc.slice(0, 180);
            if(d.age >= 0) age.textContent = d.age < 60 ? `${d.age}s fa` : `${Math.floor(d.age/60)}m fa`;
        } catch(e) {}
    }
    setInterval(() => { if(_visionOpen) refreshVision(); }, 10000);

    // ══════════════════════════════════════════════════════════
    //  KEYBOARD SHORTCUTS (JARVIS-style)
    // ══════════════════════════════════════════════════════════
    document.addEventListener('keydown', e => {
        const tag = document.activeElement.tagName;
        const inInput = tag === 'INPUT' || tag === 'TEXTAREA';

        // Spazio → toggle microfono push-to-talk
        if(e.code === 'Space' && !inInput) {
            e.preventDefault();
            toggleMic();
        }
        // Escape → stop parlato
        if(e.code === 'Escape') {
            stopSpeech();
            if(_pttActive && _ptt) _ptt.stop();
        }
        // Ctrl+K → focus input
        if(e.ctrlKey && e.key === 'k') {
            e.preventDefault();
            document.getElementById('clio-command').focus();
        }
    });

    // ══════════════════════════════════════════════════════════
    //  AVVIO
    // ══════════════════════════════════════════════════════════
    setInterval(aggiornaStati, 3000); aggiornaStati();
    setInterval(() => { fetch('/api/ping').catch(()=>{}); }, 15000);

    // Carica chat history dal server (sopravvive ai refresh)
    loadChatHistory();

    // Risync chat ogni 5s per catturare messaggi vocali dal wakeword loop
    setInterval(async () => {
        try {
            const r = await fetch('/api/chat_history?limit=30');
            if(!r.ok) return;
            const d = await r.json();
            (d.history||[]).forEach(m => {
                const key = m.ts + m.role + m.text.slice(0,20);
                if(!_chatHistoryIds.has(key)) {
                    _chatHistoryIds.add(key);
                    _renderChatMsg(m.role, m.text, m.ts);
                }
            });
        } catch(e) {}
    }, 5000);
    lucide.createIcons();
    </script>

    <script>
    // ══════════════════════════════════════════════════════════
    //  RESTYLE "JARVIS" — orbe + particelle con requestAnimationFrame
    //  (isolato: non tocca la logica esistente del brain/mic/chat)
    // ══════════════════════════════════════════════════════════
    (function(){
        const orb    = document.getElementById('orb');
        const core   = orb ? orb.querySelector('.orb-core') : null;
        const canvas = document.getElementById('particles');
        const ctx    = canvas ? canvas.getContext('2d') : null;
        const reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        // ── PARTICELLE LUMINOSE ──
        let ps = [];
        let W = 0, H = 0;

        function spawn(anywhere) {
            const cyan = Math.random() > 0.45;
            return {
                x: Math.random() * W,
                y: anywhere ? Math.random() * H : H + 10,
                r: 0.6 + Math.random() * 1.8,
                vy: 0.08 + Math.random() * 0.35,
                vx: (Math.random() - 0.5) * 0.18,
                a: 0.15 + Math.random() * 0.5,
                hue: cyan ? '0,243,255' : '168,85,247',
                tw: Math.random() * Math.PI * 2
            };
        }

        function initParticles() {
            if (!ctx) return;
            W = window.innerWidth; H = window.innerHeight;
            const dpr = Math.min(window.devicePixelRatio || 1, 1.5);
            canvas.width = W * dpr; canvas.height = H * dpr;
            canvas.style.width = W + 'px'; canvas.style.height = H + 'px';
            ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
            const n = reduce ? 16 : Math.min(70, Math.round(W / 26));
            ps = Array.from({ length: n }, () => spawn(true));
        }

        function drawParticles(dt) {
            if (!ctx) return;
            ctx.clearRect(0, 0, W, H);
            for (const p of ps) {
                p.x += p.vx; p.y -= p.vy; p.tw += dt * 1.5;
                if (p.y < -12) Object.assign(p, spawn(false));
                if (p.x < -12) p.x = W + 10; else if (p.x > W + 12) p.x = -10;
                const alpha = p.a * (0.6 + 0.4 * Math.sin(p.tw));
                ctx.beginPath();
                ctx.fillStyle = `rgba(${p.hue},${alpha.toFixed(3)})`;
                ctx.shadowBlur = 8;
                ctx.shadowColor = `rgba(${p.hue},0.8)`;
                ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
                ctx.fill();
            }
            ctx.shadowBlur = 0;
        }

        // ── ORBE: pulsazione morbida (easing) + reazione alla voce ──
        let phase = 0, smScale = 1, smGlow = 90, smAlpha = 0.45;
        let last = performance.now();

        function frame(now) {
            const dt = Math.min((now - last) / 1000, 0.05);
            last = now;
            phase += dt * 0.7;

            const lvl = (typeof audioLevel === 'number') ? Math.min(audioLevel, 1) : 0;
            if (orb && core) {
                const tScale = 1 + Math.sin(phase) * 0.05 + lvl * 0.08;
                const tGlow  = 90 + Math.sin(phase * 0.9) * 26 + lvl * 90;
                const tAlpha = 0.42 + Math.sin(phase * 0.8) * 0.08 + lvl * 0.25;
                smScale += (tScale - smScale) * 0.06;
                smGlow  += (tGlow  - smGlow)  * 0.06;
                smAlpha += (tAlpha - smAlpha) * 0.06;
                orb.style.transform = `translate(-50%,-50%) scale(${smScale.toFixed(4)})`;
                core.style.boxShadow =
                    `0 0 ${smGlow.toFixed(0)}px rgba(0,191,255,${smAlpha.toFixed(3)}),` +
                    `0 0 ${(smGlow*2).toFixed(0)}px rgba(168,85,247,${(smAlpha*0.7).toFixed(3)}),` +
                    `0 0 ${(smGlow*3.4).toFixed(0)}px rgba(0,191,255,${(smAlpha*0.35).toFixed(3)}),` +
                    `inset 0 0 ${(smGlow*0.8).toFixed(0)}px rgba(0,243,255,${(smAlpha*0.8).toFixed(3)})`;
            }

            drawParticles(dt);
            requestAnimationFrame(frame);
        }

        initParticles();
        window.addEventListener('resize', initParticles);
        requestAnimationFrame(frame);
    })();
    </script>
</body>
</html>
